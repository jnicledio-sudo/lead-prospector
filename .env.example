# Google Maps / Places API Key (Opcional se usar Modo Demonstração / OSM)
# Obtenha gratuitamente em: https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=

# Chave de IA para Geração Automática de Propostas (100% Gratuita)
# Opção 1: Google Gemini (Recomendado) -> Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=

# Opção 2: Groq (Llama 3.3) -> Obtenha em: https://console.groq.com/
GROQ_API_KEY=
